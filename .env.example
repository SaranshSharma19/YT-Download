# Trading Bot Environment Variables

# ==========================================
# General Configuration
# ==========================================
# Run mode: True for paper trading/simulated, False for live execution
DRY_RUN=True

# Timezone for logging and trading logic
TIMEZONE=Asia/Kolkata

# Initial account balance used for position sizing
ACCOUNT_BALANCE=100000.0

# ==========================================
# Risk Management (Can be overridden by risk_config.json)
# ==========================================
# Basic risk per trade (e.g., 0.015 = 1.5% of capital)
RISK_PER_TRADE=0.015

# Maximum daily loss limit (e.g., 0.03 = 3%)
MAX_DAILY_LOSS=0.03

# Maximum position size as a fraction of account balance
MAX_POSITION_SIZE=0.10

# Cooldown after a trade closes (in minutes)
COOLDOWN_MINUTES=30

# Transaction cost estimation (per lot, both sides)
TRANSACTION_COST_PER_LOT=80.0

# ==========================================
# Broker API Keys (Fill these in for live trading)
# ==========================================
BROKER_API_KEY=your_broker_api_key_here
BROKER_API_SECRET=your_broker_api_secret_here
BROKER_ACCESS_TOKEN=your_broker_access_token_here

# ==========================================
# Notification & Webhook URLs
# ==========================================
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
